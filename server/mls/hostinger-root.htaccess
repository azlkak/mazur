# Keep the existing /api directory and the private MLS import untouched.
# Only public WWW requests are served from the isolated auto-deployed build.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?mazurestate\.pl$ [NC]
RewriteCond %{REQUEST_URI} !^/api(/|$) [NC]
RewriteCond %{REQUEST_URI} !^/site-live(/|$) [NC]
RewriteRule ^(.*)$ site-live/$1 [L]
