RewriteEngine On
RewriteRule ^(?:(?:en|uk|ru)/)?wyniki-wyszukiwania/(?:index\.html)?$ wyniki-wyszukiwania/index.php [L]
RewriteRule ^sitemap-oferty\.xml$ sitemap-oferty.php [L]

<IfModule mod_headers.c>
  SetEnvIfNoCase Host "^(?!((www\.)?mazurestate\.pl)$).+" MAZUR_STAGE=1
  Header always set X-Robots-Tag "noindex, nofollow" env=MAZUR_STAGE
</IfModule>
